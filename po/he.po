#: rolodex.py
msgid "That file is too large to import (the limit is 10 MB)."
msgstr "הקובץ גדול מכדי לייבא אותו (המגבלה היא 10 MB)."

#: rolodex.py
msgid ""
"This vault was made by a newer version of Rolodex. Update Rolodex to open it."
msgstr "כספת זו נוצרה בגרסה חדשה יותר של Rolodex. יש לעדכן את Rolodex כדי לפתוח אותה."

#: rolodex.py
msgid "This vault is already open in another Rolodex window."
msgstr "כספת זו כבר פתוחה בחלון Rolodex אחר."

#: rolodex.py
msgid "Vault file is truncated or corrupt"
msgstr "קובץ הכספת קטוע או פגום"

#: rolodex.py
msgid "Not a valid vault file"
msgstr "אינו קובץ כספת תקין"

#: rolodex.py
msgid "A vault already exists here. Restart Rolodex to unlock it."
msgstr "כבר קיימת כאן כספת. יש להפעיל מחדש את Rolodex כדי לפתוח אותה."

#: rolodex.py
msgid "That file is too large to be a Rolodex vault."
msgstr "הקובץ גדול מכדי להיות כספת Rolodex."

#: rolodex.py
msgid "That file is not a Rolodex vault."
msgstr "הקובץ אינו כספת Rolodex."

#: rolodex.py
msgid "Vault contents are not a valid vault"
msgstr "תוכן הכספת אינו כספת תקינה"

#: rolodex.py
#, python-brace-format
msgid ""
"This vault was written by a newer version of Rolodex (format v{version}). "
"Upgrade Rolodex to open it."
msgstr "כספת זו נכתבה בגרסה חדשה יותר של Rolodex (תבנית v{version}). יש לשדרג את Rolodex כדי לפתוח אותה."

