#, python-brace-format
msgid "The vault was not written to disk: {error}"
msgstr "הכספת לא נכתבה לכונן: {error}"

#: rolodex.py
msgid "Vault Changed Elsewhere"
msgstr "הכספת שונתה במקום אחר"

#: rolodex.py
msgid ""
"The vault file was changed by something else since you unlocked it — another "
"copy of Rolodex, a sync tool, or a file copied over it. Your latest change "
"was NOT saved.\n"
"\n"
"Reload locks Rolodex so you can unlock the version on disk; your unsaved "
"change is discarded. Overwrite replaces the version on disk with everything "
"open here, which discards the other change instead."
msgstr "קובץ הכספת שונה על ידי גורם אחר מאז שחרור הנעילה — עותק אחר של Rolodex, כלי סנכרון, או קובץ שהועתק מעליו. השינוי האחרון שלך לא נשמר.\n\nטעינה מחדש נועלת את Rolodex כדי שאפשר יהיה לפתוח את הגרסה שבכונן; השינוי שלא נשמר יושלך. דריסה מחליפה את הגרסה שבכונן בכל מה שפתוח כאן, ובמקום זאת משליכה את השינוי האחר."

#: rolodex.py
msgid "Reload From Disk"
msgstr "טעינה מחדש מהכונן"

#: rolodex.py
msgid "Overwrite"
msgstr "דריסה"

#: rolodex.py
msgid "Saved over the changed vault"
msgstr "נשמר מעל הכספת ששונתה"

