msgid_plural "{names} and {n} more"
msgstr[0] "{names} ועוד {n}"
msgstr[1] "{names} ועוד {n}"

#: rolodex.py
#, python-brace-format
msgid "Delete {n} entry?"
msgid_plural "Delete {n} entries?"
msgstr[0] "למחוק {n} רשומה?"
msgstr[1] "למחוק {n} רשומות?"

#. Translators: {names} is a list of quoted entry names.
