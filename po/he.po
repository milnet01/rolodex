msgstr "\"{name}\""

#. Translators: the separator between names in a list, e.g. '"A", "B", "C"'.
#: rolodex.py
msgid ", "
msgstr ", "

#. Translators: {names} is three quoted entry names; {n} is how many more there are.
#: rolodex.py
