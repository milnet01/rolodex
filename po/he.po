msgstr "שונתה: {date}"

#: rolodex.py
msgid "Code"
msgstr "קוד"

#: rolodex.py
msgid ""
"Your computer's clock is not synchronised, so this code may be rejected. "
"Turn on automatic time in your system settings."
msgstr "שעון המחשב אינו מסונכרן, ולכן ייתכן שהקוד הזה יידחה. יש להפעיל שעה אוטומטית בהגדרות המערכת."

#: rolodex.py
msgid "Copy 2FA code"
msgstr "העתקת קוד 2FA"

#: rolodex.py
msgid "2FA code"
msgstr "קוד 2FA"

#. Translators: seconds left before a 2FA code changes; "s" abbreviates "seconds".
#: rolodex.py
#, python-brace-format
msgid "{seconds}s"
msgstr "{seconds} שנ׳"

#: rolodex.py
msgid "Clipboard not available"
msgstr "לוח הגזירים אינו זמין"

#. Translators: {label} is a field's name, e.g. "Password"; "s" abbreviates "seconds".
#: rolodex.py
#, python-brace-format
msgid "Copied {label} — clipboard clears in {seconds}s"
msgstr "הועתק: {label} — לוח הגזירים יתרוקן בעוד {seconds} שנ׳"

#. Translators: {label} is a field's name, e.g. "Password".
#: rolodex.py
#, python-brace-format
msgid "Copied {label}"
msgstr "הועתק: {label}"

#: rolodex.py
msgid "Couldn't save that setting — the settings file is not writable"
msgstr "לא ניתן לשמור את ההגדרה — אין הרשאת כתיבה לקובץ ההגדרות"

#: rolodex.py
msgid "Rolodex will check for updates on startup"
msgstr "בעת ההפעלה, Rolodex יבדוק אם יש עדכונים"

#: rolodex.py
msgid "Automatic update checks turned off"
msgstr "בדיקת העדכונים האוטומטית כובתה"

#: rolodex.py
msgid "Updates not available"
msgstr "עדכונים אינם זמינים"

#: rolodex.py
msgid ""
"In-app updates work only in the packaged Rolodex build. Running from source "
"or from a distribution package, updating is handled outside the app."
msgstr "עדכונים מתוך היישום פועלים רק בגרסה הארוזה של Rolodex. בהרצה מקוד המקור או מחבילה של הפצה, העדכון מתבצע מחוץ ליישום."

#: rolodex.py
msgid "Checking for updates..."
msgstr "מתבצעת בדיקת עדכונים..."

#: rolodex.py
#, python-brace-format
msgid "Couldn't check for updates: {error}"
msgstr "לא ניתן לבדוק אם יש עדכונים: {error}"

#: rolodex.py
#, python-brace-format
msgid "Rolodex {version} is up to date"
msgstr "הגרסה Rolodex {version} עדכנית"

#: rolodex.py
#, python-brace-format
msgid "Downloading Rolodex {version}..."
msgstr "מתבצעת הורדה של Rolodex {version}..."

#: rolodex.py
msgid "Update rejected"
msgstr "העדכון נדחה"

#: rolodex.py
msgid ""
"The downloaded update was not signed by the Rolodex release key, so it was "
"discarded and nothing was installed. Your current version is untouched."
msgstr "העדכון שהורד לא נחתם במפתח השחרור של Rolodex, ולכן הוא הושלך ושום דבר לא הותקן. הגרסה הנוכחית שלך לא השתנתה."

#: rolodex.py
msgid "Update failed"
msgstr "העדכון נכשל"

#: rolodex.py
msgid "Select an entry first"
msgstr "יש לבחור רשומה תחילה"

#: rolodex.py
msgid "No sensitive field to copy"
msgstr "אין שדה רגיש להעתקה"

#: rolodex.py
msgid "Delete entry?"
msgstr "למחוק את הרשומה?"

#: rolodex.py
#, python-brace-format
msgid "Delete \"{name}\"? This cannot be undone."
msgstr "למחוק את \"{name}\"? אי אפשר לבטל פעולה זו."

#. Translators: one entry's name inside a list of names, quoted.
#: rolodex.py
#, python-brace-format
