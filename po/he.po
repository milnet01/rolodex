msgstr "כספות Rolodex"

#: rolodex.py
msgid "Vault file installed. Enter its master password to unlock it."
msgstr "קובץ הכספת הותקן. יש להזין את הסיסמה הראשית שלו כדי לפתוח אותו."

#. Translators: appended, after a space, to "Vault file installed. Enter its master
#. password to unlock it."
#: rolodex.py
#, python-brace-format
msgid "The unreadable vault was kept as {filename}."
msgstr "הכספת שלא ניתן היה לקרוא נשמרה בשם {filename}."

#: rolodex.py
msgid "Start a New Vault?"
msgstr "להתחיל כספת חדשה?"

#: rolodex.py
msgid ""
"The vault that will not open is kept, renamed beside the original with "
"“.unreadable-” and the date added, so it can still be recovered. A new, "
"empty vault is then created with a new master password."
msgstr "הכספת שאינה נפתחת נשמרת בשם חדש לצד המקורית, בתוספת “.unreadable-” והתאריך, כדי שעדיין יהיה אפשר לשחזר אותה. לאחר מכן נוצרת כספת חדשה וריקה עם סיסמה ראשית חדשה."

#: rolodex.py
msgid "Cancel"
msgstr "ביטול"

#: rolodex.py
msgid "Start New Vault"
msgstr "התחלת כספת חדשה"

