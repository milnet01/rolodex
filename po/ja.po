msgid "Vault file is truncated or corrupt"
msgstr "保管庫ファイルが途中で切れているか、破損しています"

#: rolodex.py
msgid "Not a valid vault file"
msgstr "有効な保管庫ファイルではありません"

#: rolodex.py
msgid "A vault already exists here. Restart Rolodex to unlock it."
msgstr "ここにはすでに保管庫があります。ロックを解除するには Rolodex を再起動してください。"

#: rolodex.py
msgid "That file is too large to be a Rolodex vault."
msgstr "このファイルは Rolodex の保管庫としては大きすぎます。"

