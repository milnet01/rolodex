#: rolodex.py
msgid "That file is too large to import (the limit is 10 MB)."
msgstr "Ese archivo es demasiado grande para importarlo (el límite es 10 MB)."

#: rolodex.py
msgid ""
"This vault was made by a newer version of Rolodex. Update Rolodex to open it."
msgstr "Esta bóveda se creó con una versión más reciente de Rolodex. Actualice Rolodex para abrirla."

#: rolodex.py
msgid "This vault is already open in another Rolodex window."
msgstr "Esta bóveda ya está abierta en otra ventana de Rolodex."

