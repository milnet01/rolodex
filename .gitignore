# NEVER publish real credential data
contacts.vault
*.vault
Backups/
.rolodex.conf

# NEVER publish the release-signing private key (ROLO-0037). The public half belongs in
# rolodex.py; the private half belongs in a GitHub Actions secret and a backup, and nowhere
# in this repository. Losing it is unrecoverable -- shipped binaries will refuse every
# update signed by any other key.
*.key
*.pem
rolodex-signing.key

# Local export/import artifacts
rolodex_export_*.txt

# Python
__pycache__/
*.pyc

# PyInstaller / build output
/dist/
/build/
/build_pyi/
/out/
/packaging/build/
/packaging/dist/
*.spec.bak

# Editor / OS cruft
.claude/settings.local.json
